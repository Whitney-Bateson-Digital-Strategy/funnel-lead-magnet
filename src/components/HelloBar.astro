---
// HelloBar — sticky top bar with brand context
---

<div class="hello-bar">
  <span class="ornament">✦</span>
  A free tool from{' '}
  <span class="brand">Whitney Bateson Digital Strategy</span>
  <span class="ornament">✦</span>
</div>

<style>
  .hello-bar {
    padding: 0.7rem 1.5rem;
    background: var(--teal-dark);
    color: var(--cream);
    position: sticky;
    top: 0;
    z-index: 100;
    text-align: center;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  .ornament {
    opacity: 0.7;
    margin: 0 0.5rem;
  }

  .brand {
    font-weight: 700;
  }
</style>
